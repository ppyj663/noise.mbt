///|
fn cacophony_json() -> String {
  let mut acc = ""
  for part in cacophony_chunks_0 {
    acc = acc + part
  }
  for part in cacophony_chunks_1 {
    acc = acc + part
  }
  for part in cacophony_chunks_2 {
    acc = acc + part
  }
  acc
}
